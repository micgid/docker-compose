# Données de test - illustre les trois types d'attributs
#
# Multi-valeurs natifs LDAP  : mail, telephoneNumber  (attribut répété)
# customTag                  : liste libre (multi-valeurs)
# customProperty             : dictionnaire plat, format "cle=valeur" (multi-valeurs)
# customJsonData             : dictionnaire imbriqué complet sérialisé en JSON (mono-valeur)

# ── Personne 1 : ingénieur, profil technique ──────────────────────────────────
dn: uid=jdupont,ou=people,dc=example,dc=com
objectClass: inetOrgPerson
objectClass: customAttributes
uid: jdupont
cn: Jean Dupont
sn: Dupont
givenName: Jean
mail: jean.dupont@example.com
mail: jdupont@perso.fr
mail: j.dupont.pro@gmail.com
telephoneNumber: +33 1 23 45 67 89
telephoneNumber: +33 6 12 34 56 78
customTag: python
customTag: java
customTag: kubernetes
customTag: cloud-aws
customTag: terraform
customProperty: niveau=senior
customProperty: departement=engineering
customProperty: statut=actif
customProperty: bureau=Paris-3
customProperty: manager=mmartin
customJsonData: {"config":{"theme":"dark","langue":"fr","notifications":true},"acces":["dashboard","monitoring","deploy"],"quota":{"storage":"50GB","api_calls":10000}}

# ── Personne 2 : manager ──────────────────────────────────────────────────────
dn: uid=mmartin,ou=people,dc=example,dc=com
objectClass: inetOrgPerson
objectClass: customAttributes
uid: mmartin
cn: Marie Martin
sn: Martin
givenName: Marie
mail: marie.martin@example.com
mail: mmartin@consulting.fr
telephoneNumber: +33 1 98 76 54 32
customTag: management
customTag: agile
customTag: communication
customProperty: niveau=manager
customProperty: departement=engineering
customProperty: statut=actif
