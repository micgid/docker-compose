# ── Groupes ───────────────────────────────────────────────────────────────────
dn: cn=team-engineering,ou=groups,dc=example,dc=com
objectClass: groupOfNames
cn: team-engineering
description: Equipe ingenierie
member: uid=jdupont,ou=people,dc=example,dc=com
member: uid=mmartin,ou=people,dc=example,dc=com
member: uid=aleblanc,ou=people,dc=example,dc=com

