customProperty: budget_annuel=250000
customJsonData: {"equipe":["jdupont","aleblanc"],"objectifs":{"Q1":"migration_cloud","Q2":"refonte_api"},"kpis":{"satisfaction":4.2,"livraison_ontime":95}}

