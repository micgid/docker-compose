# ── Compte de service ─────────────────────────────────────────────────────────
dn: uid=svc-monitoring,ou=services,dc=example,dc=com
objectClass: inetOrgPerson
objectClass: customAttributes
uid: svc-monitoring
cn: Service Monitoring
sn: Monitoring
mail: monitoring@example.com
userPassword: ServicePass2024!
customTag: monitoring
customTag: alerting
customTag: production
customProperty: env=production
customProperty: version=3.1.2
customProperty: scrape_interval=15s
customProperty: retention=30d
customJsonData: {"targets":["app:8080","db:5432","cache:6379"],"alertes":{"cpu":85,"mem":90,"latency_ms":500},"labels":{"cluster":"prod","region":"eu-west-1"}}
